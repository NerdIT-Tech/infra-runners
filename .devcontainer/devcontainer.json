{
    "name": "infra-runners-dev",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "customizations": {
        "vscode": {
            "extensions": [
                "hashicorp.terraform",
                "redhat.ansible",
                "github.vscode-github-actions",
                "ms-vscode.powershell",
                "eamodio.gitlens",
                "redhat.vscode-yaml",
                "skellock.just"
            ]
        }
    },
    "remoteUser": "vscode",
    "features": {
        //"./features/xdg-utils": {},
        "./features/gemini-persistence": {},
        "./features/podman-remote": {},
        "ghcr.io/stu-bell/devcontainer-features/gemini-cli:0": {}
    }
}
